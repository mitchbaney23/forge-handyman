{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/backup-sheet",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/send-review-requests",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/lifecycle",
      "schedule": "0 13 * * *"
    }
  ]
}
