{
  "name": "forge-handyman",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "secret-scan": "secretlint --maskSecrets \"**/*\" \"!**/node_modules/**\" \"!**/.next/**\" \"!**/.git/**\" \"!**/package-lock.json\"",
    "setup-sheet": "tsx scripts/setup-sheet.ts"
  },
  "lint-staged": {
    "*": [
      "secretlint --maskSecrets"
    ],
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^10.53.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "googleapis": "^144.0.0",
    "libphonenumber-js": "^1.13.3",
    "next": "^16.2.6",
    "next-auth": "^4.24.14",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.4.38",
    "secretlint": "^13.0.2",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.3",
    "typescript": "^5.4.5"
  }
}
