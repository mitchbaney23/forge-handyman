# Google Workspace Integration
# Create a Google Cloud service account with domain-wide delegation
# and grant it access to Gmail, Calendar, and Sheets APIs.
GOOGLE_SERVICE_ACCOUNT_EMAIL=forge-handyman@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# The calendar ID (usually the user's email) the event will be added to.
GOOGLE_CALENDAR_ID=david@forgehandyman.com

# The ID of the Google Sheet that acts as the lightweight CRM.
# Found in the sheet URL: docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# Where the form notification is sent.
BUSINESS_EMAIL=david@forgehandyman.com

# Development mode: when "true", /api/contact logs to the console
# instead of calling Google APIs. Leave blank/false in production.
NEXT_PUBLIC_DEV_MODE=true

# Public site URL (used for canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://forgehandyman.com
