# =============================================================================
# Forge Handyman — Environment variables reference
# =============================================================================
# Real values live in Vercel (Settings → Environment Variables) — never in
# this file. Mark anything with `SECRET`, `TOKEN`, or `PRIVATE_KEY` in its
# name as Sensitive in Vercel. For local dev, copy this file to .env.local
# and fill in real values; .env.local is gitignored.
# =============================================================================


# --- Google Workspace (Gmail / Calendar / Sheets via service account) --------
GOOGLE_SERVICE_ACCOUNT_EMAIL=forge-handyman@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=admin@forgehandyman.com
GOOGLE_SHEET_ID=your-google-sheet-id
BUSINESS_EMAIL=admin@forgehandyman.com
GOOGLE_GEOCODING_API_KEY=
SERVICE_AREA_RADIUS_MILES=15

# Google Maps JS API key (browser-side) for Places Autocomplete on the
# contact form. Create in Google Cloud Console:
#   1. APIs & Services -> Credentials -> Create credentials -> API key
#   2. Restrict the key: HTTP referrers limited to forgehandyman.com/* and *.forgehandyman.com/*
#   3. API restrictions: enable Maps JavaScript API + Places API
# This key is shipped to browsers (NEXT_PUBLIC_ prefix) so the HTTP
# referrer restriction is the primary defense. Separate from
# GOOGLE_GEOCODING_API_KEY (which is server-side, IP-restricted).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# --- Site configuration ------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://forgehandyman.com
# When "true", /api/contact logs submissions instead of calling Google APIs.
NEXT_PUBLIC_DEV_MODE=false


# --- NextAuth (admin login via Google OAuth) ---------------------------------
NEXTAUTH_URL=https://forgehandyman.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated list of emails allowed to log into /admin.
ADMIN_ALLOWLIST=admin@forgehandyman.com


# --- Upstash Redis (rate limiting + webhook idempotency) ---------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# --- Sentry (error tracking) -------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional — only needed at build time for source-map uploads.
SENTRY_AUTH_TOKEN=


# --- Cloudflare Turnstile (contact form bot protection) ----------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# --- Stripe (Stage 3+) -------------------------------------------------------
STRIPE_SECRET_KEY_TEST=
STRIPE_PUBLISHABLE_KEY_TEST=
STRIPE_WEBHOOK_SECRET_TEST=
STRIPE_SECRET_KEY_LIVE=
STRIPE_PUBLISHABLE_KEY_LIVE=
STRIPE_WEBHOOK_SECRET_LIVE=


# --- Twilio (Stage 4+) -------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# Long random token used for the bookmarklet endpoint David hits from his
# phone (no full login). Generate with: openssl rand -hex 32
DAVID_HEADS_UP_TOKEN=


# --- Follow-up automation (Stage 6+) -----------------------------------------
# HMAC secret used to sign one-click unsubscribe tokens.
# Generate with: openssl rand -base64 32
UNSUBSCRIBE_HMAC_SECRET=

# Direct link to leave Forge a Google review. Find via Google Maps:
#   search your business -> Share -> Embed a map -> grab the place URL,
#   OR build via:
#   https://search.google.com/local/writereview?placeid=<YOUR_PLACE_ID>
# If unset, customer review CTA falls back to a Google search for Forge.
GOOGLE_REVIEW_URL=


# --- Kill switches (Stage 8+) ------------------------------------------------
# When "true", /api/contact returns 503 with a "we're updating, call us" body.
CONTACT_FORM_DISABLED=
# When "true", scheduled automations (review requests, seasonal nudges) skip.
AUTOMATIONS_DISABLED=


# --- Cron jobs (Stage 7+) ----------------------------------------------------
# Shared secret Vercel sends in Authorization header on cron invocations.
# Generate with: openssl rand -hex 32
CRON_SECRET=


# --- Logging -----------------------------------------------------------------
# Optional override. Defaults: debug in dev, info in production.
LOG_LEVEL=
