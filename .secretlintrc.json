{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "Supabase secret API key",
            "pattern": "/sb_secret_[A-Za-z0-9_-]+/"
          },
          {
            "name": "Supabase service_role JWT",
            "pattern": "/eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*(?:c2VydmljZV9yb2xl|cnZpY2Vfcm9s|ZXJ2aWNlX3Jv)[A-Za-z0-9_-]*\\.[A-Za-z0-9_-]+/"
          }
        ]
      }
    }
  ]
}
